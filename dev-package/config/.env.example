# ─────────────────────────────────────────────────────────────────
# The Doc Mirror — Environment Variables (v4)
# Copy to .env.local and fill in real values
# NEVER commit .env.local to GitHub
# ─────────────────────────────────────────────────────────────────

# ── APP ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.thedocmirror.com
API_READY=false
# Keep API_READY=false until /api/audit returns real Google Places data

# ── GOOGLE APIs (Sprint 1-2) ────────────────────────────────────
# Google Places API — GMB data (billing must be enabled)
# Pricing: ~$0.017 per Places Details call
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google PageSpeed Insights API (FREE)
GOOGLE_PAGESPEED_KEY=your_pagespeed_key_here

# ── SERPAPI (Sprint 2) ──────────────────────────────────────────
# Local rank tracker, brand search trends, directory detection
# Plans from $50/mo. 100 free searches on trial.
SERPAPI_KEY=your_serpapi_key_here

# ── YOUTUBE (Sprint 2) ──────────────────────────────────────────
# YouTube Data API v3 — FREE (10k units/day)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── ANTHROPIC / CLAUDE (Sprint 2) ───────────────────────────────
# Used for all AI-generated content (issues, fixes, journey, plan)
# Model: claude-sonnet-4-20250514
# Cost: ~$0.08 per full audit (8 prompts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── REAL AI QUERIES (Sprint 3 — paid tier only) ─────────────────
# These three APIs are ONLY used for paid reports and the Monitor/Agency plans.
# Free tier uses synthetic scoring — these are not needed for Sprint 1-2.
OPENAI_API_KEY=your_openai_key_here
GOOGLE_AI_API_KEY=your_google_ai_studio_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ── SUPABASE ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── GMAIL (report PDF delivery via nodemailer) ───────────────────
# Use a Google account with 2FA + App Password: myaccount.google.com/apppasswords
GMAIL_USER=hello@yourdomain.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Local dev only: set true if you get TLS/certificate errors on Windows
# GMAIL_TLS_STRICT=true

# ── STRIPE (PAYMENTS) ────────────────────────────────────────────
# Create products in Stripe dashboard:
#   1. "Full Audit Report" — one-time $19
#   2. "Monitor Plan" — recurring $49/month
# NO Done For You tier — DFY was removed in v4.
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

STRIPE_PRICE_REPORT=price_xxxx_report_19
STRIPE_PRICE_MONITOR=price_xxxx_monitor_49

# ── REGION / PRICING TIER ────────────────────────────────────────────────────
# Where a visitor lands when geo tells us nothing: no x-vercel-ip-country header
# (localhost), an unknown country, Tor. India-first, so IN.
DEFAULT_REGION_TIER=IN

# SINGLE-MARKET KILL SWITCH. While set, resolveRegion ignores geo headers AND an
# explicit ?region= and answers IN for everyone: every visitor sees Rs pricing
# and is charged INR on Razorpay India.
# Reason: a USD order cannot settle on the India Razorpay account, so quoting USD
# to anyone today is quoting a price we cannot collect.
# AT US LAUNCH: delete this line. TIERS.US / TIERS.INTL and their provider
# routing are untouched and start working again with no code change.
FORCE_REGION_TIER=IN

# ── RAZORPAY (INR billing — primary checkout flow) ──────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR

# Per-plan amounts in the smallest currency unit (paise). One variable per plan.
# These OVERRIDE the code defaults in lib/pricing.js (TIERS.IN) — envAmount()
# reads env first — so a price change must land in BOTH places, or the page shows
# one price and the card is charged another.
# Report  → ₹999 → 99900 paise. This IS the charged amount: it is sent to
#   razorpay.orders.create for the one-time report.
RAZORPAY_STARTER_AMOUNT_UNITS=99900
# Monitor → ₹1,999 → 199900 paise. Display/metadata ONLY — the charged amount is
#   fixed on the Razorpay Plan below. Keep the two in sync.
RAZORPAY_MONITOR_AMOUNT_UNITS=199900

# Display strings for the India tier, kept beside the amounts they describe so an
# amount change cannot leave a stale price on the page. Read by envDisplay().
PRICE_IN_REPORT_DISPLAY=₹999
PRICE_IN_MONITOR_DISPLAY=₹1,999/month

# Deprecated: superseded by RAZORPAY_STARTER_AMOUNT_UNITS. Still honoured as a
# fallback so an in-flight deployment does not break. Remove once every
# environment sets the variable above.
# RAZORPAY_AMOUNT_UNITS=99900

# Razorpay Subscription plan IDs. THESE are what actually bill a subscriber —
# RAZORPAY_MONITOR_AMOUNT_UNITS above is metadata only. Razorpay does NOT allow
# editing the price of an existing plan, so any price change means creating a NEW
# plan and pasting its ID here.
#
# A plan ID belongs to the mode it was created in: a plan_… made in Razorpay TEST
# mode only works with an rzp_test_ key, and a LIVE plan only with rzp_live_.
# Mixing them fails subscription creation with "The id provided does not exist".
# Keep the plan IDs and RAZORPAY_KEY_ID in the SAME mode.
#
# Create in Razorpay dashboard: Products → Plans → Create Plan
#   period=monthly, interval=1
#
# Doctor Visibility Monitor — single doctor (₹1,999/month)
#   item.name="docmirror-singledoc", amount=199900, currency=INR
RAZORPAY_MONITOR_PLAN_ID=plan_xxxxxxxxxxxx
# Agency / organization — 10 doctor profiles (₹7,999/month)
#   item.name="docmirror-organization", amount=799900, currency=INR
# Not read by any code yet; the agency checkout route is a later phase.
RAZORPAY_AGENCY_PLAN_ID=plan_xxxxxxxxxxxx

# Razorpay Webhook secret — from Razorpay dashboard → Webhooks → your endpoint → Secret
# Used to verify HMAC-SHA256 signatures on /api/webhook-razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── CASHFREE (USD billing — International Payment Gateway) ────────
# Handles US/INTL regions (region→provider map in lib/payments/index.js:
# IN → razorpay, else → cashfree). Provider module: lib/payments/cashfree.js.
# Razorpay/INR checkout ignores these.
#
# 'sandbox' = Cashfree test gateway; 'production' = live. Also selects the JS SDK
# mode surfaced to the frontend via /api/client-config.
CASHFREE_ENV=sandbox
# API base URL — must match CASHFREE_ENV:
#   sandbox    → https://sandbox.cashfree.com/pg
#   production → https://api.cashfree.com/pg
CASHFREE_API_BASE=https://sandbox.cashfree.com/pg
# App ID (client id) from Cashfree dashboard → Developers → API Keys.
CASHFREE_APP_ID=your_cashfree_app_id
# Secret key (client secret) — server-side only, NEVER sent to the browser.
# Also used to verify webhook signatures (base64 HMAC-SHA256 of timestamp+body).
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Public origin of this deployment (no trailing slash), e.g.
# https://www.thedocmirror.com — used to build Cashfree return_url / notify_url.
# Cashfree cannot reach localhost, so use a public URL/tunnel for webhook testing.
APP_BASE_URL=https://www.thedocmirror.com
# NOTE: the Cashfree API version (x-api-version: 2023-08-01) is pinned in
# lib/payments/cashfree.js, not an env var.

# ── VERCEL CRON (weekly monitor job) ─────────────────────────────
# Set in Vercel dashboard — auto-sent as Authorization: Bearer header
CRON_SECRET=your_random_cron_secret

# ── CHROME / PUPPETEER ───────────────────────────────────────────
# Optional. Puppeteer downloads its own Chromium on npm install.
# Only set this if you want to use a specific Chrome installation instead.
# Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux:   /usr/bin/google-chrome
# CHROME_PATH=

# -- RESOURCES CMS (public hybrid: Markdown + Supabase blog_posts) ---
# The public /resources section merges the Markdown articles in
# content/resources/ with publicly-eligible rows from blog_posts.
# All three are OPTIONAL - the defaults are what production should use.
#
# Instant rollback: set to false and redeploy. The public site serves the
# Markdown articles only, exactly as it did before the CMS existed.
RESOURCES_CMS_ENABLED=true
# How long a fetched CMS set is served before a refresh is attempted (ms).
# This is the worst-case delay between pressing Publish and the article
# appearing. Only the first request on a cold instance ever waits.
RESOURCES_CMS_TTL_MS=60000
# After a failed fetch, how long before another attempt (ms). Without this an
# outage would make every request pay the full Supabase timeout.
RESOURCES_CMS_BACKOFF_MS=15000
