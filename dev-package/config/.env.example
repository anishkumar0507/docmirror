# ─────────────────────────────────────────────────────────────────
# The Doc Mirror — Environment Variables (v4)
# Copy to .env.local and fill in real values
# NEVER commit .env.local to GitHub
# ─────────────────────────────────────────────────────────────────

# ── APP ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.thedocmirror.com
API_READY=false
# Keep API_READY=false until /api/audit returns real Google Places data

# ── GOOGLE APIs (Sprint 1-2) ────────────────────────────────────
# Google Places API — GMB data (billing must be enabled)
# Pricing: ~$0.017 per Places Details call
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google PageSpeed Insights API (FREE)
GOOGLE_PAGESPEED_KEY=your_pagespeed_key_here

# ── SERPAPI (Sprint 2) ──────────────────────────────────────────
# Local rank tracker, brand search trends, directory detection
# Plans from $50/mo. 100 free searches on trial.
SERPAPI_KEY=your_serpapi_key_here

# ── YOUTUBE (Sprint 2) ──────────────────────────────────────────
# YouTube Data API v3 — FREE (10k units/day)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── ANTHROPIC / CLAUDE (Sprint 2) ───────────────────────────────
# Used for all AI-generated content (issues, fixes, journey, plan)
# Model: claude-sonnet-4-20250514
# Cost: ~$0.08 per full audit (8 prompts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── REAL AI QUERIES (Sprint 3 — paid tier only) ─────────────────
# These three APIs are ONLY used for $19 reports and $49 Monitor.
# Free tier uses synthetic scoring — these are not needed for Sprint 1-2.
OPENAI_API_KEY=your_openai_key_here
GOOGLE_AI_API_KEY=your_google_ai_studio_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ── SUPABASE ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── GMAIL (report PDF delivery via nodemailer) ───────────────────
# Use a Google account with 2FA + App Password: myaccount.google.com/apppasswords
GMAIL_USER=hello@yourdomain.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Local dev only: set true if you get TLS/certificate errors on Windows
# GMAIL_TLS_STRICT=true

# ── STRIPE (PAYMENTS) ────────────────────────────────────────────
# Create products in Stripe dashboard:
#   1. "Full Audit Report" — one-time $19
#   2. "Monitor Plan" — recurring $49/month
# NO Done For You tier — DFY was removed in v4.
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

STRIPE_PRICE_REPORT=price_xxxx_report_19
STRIPE_PRICE_MONITOR=price_xxxx_monitor_49

# ── RAZORPAY (INR billing — primary checkout flow) ──────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR

# Per-plan amounts in the smallest currency unit (paise). One variable per plan.
# Starter ($19 display)  → ₹1,828 → 182800 paise. This IS the charged amount:
#   it is sent to razorpay.orders.create for the one-time report.
RAZORPAY_STARTER_AMOUNT_UNITS=182800
# Monitor ($49 display)  → ₹4,715 → 471500 paise. Display/metadata ONLY — the
#   charged amount is fixed on the Razorpay Plan below. Keep the two in sync.
RAZORPAY_MONITOR_AMOUNT_UNITS=471500

# Deprecated: superseded by RAZORPAY_STARTER_AMOUNT_UNITS. Still honoured as a
# fallback so an in-flight deployment does not break. Remove once every
# environment sets the variable above.
# RAZORPAY_AMOUNT_UNITS=182800

# Razorpay Subscription plan ID for Doctor Visibility Monitor (₹4,715/month)
# Razorpay does NOT allow editing the price of an existing plan. Any price
# change means creating a NEW plan and pasting its ID here.
# Create in Razorpay dashboard: Products → Plans → Create Plan
#   period=monthly, interval=1, item.name="Doctor Visibility Monitor",
#   amount=471500, currency=INR
RAZORPAY_MONITOR_PLAN_ID=plan_xxxxxxxxxxxx

# Razorpay Webhook secret — from Razorpay dashboard → Webhooks → your endpoint → Secret
# Used to verify HMAC-SHA256 signatures on /api/webhook-razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── VERCEL CRON (weekly monitor job) ─────────────────────────────
# Set in Vercel dashboard — auto-sent as Authorization: Bearer header
CRON_SECRET=your_random_cron_secret

# ── CHROME / PUPPETEER ───────────────────────────────────────────
# Optional. Puppeteer downloads its own Chromium on npm install.
# Only set this if you want to use a specific Chrome installation instead.
# Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux:   /usr/bin/google-chrome
# CHROME_PATH=

# -- CONTENT CMS (Resources) -----------------------------------------------
# The Resources section loads posts from the central CMS, falling back to the
# Markdown files in content/resources/ whenever the CMS is unreachable.
# Leave CMS_API_URL blank to run purely on Markdown, exactly as before.

# Website API base URL, including /api/v1. No trailing slash.
CMS_API_URL=https://your-cms.vercel.app/api/v1

# API key scoped to THIS website. CMS -> API keys -> Create.
# Shown once; only a hash is stored server-side.
CMS_API_KEY=pk_live_your_key_here

# merge     (default) CMS posts + Markdown posts, CMS wins on a slug clash.
# cms-only  CMS only; Markdown becomes a failure-only fallback.
# Keep `merge` until the existing Markdown articles are migrated, or they will
# disappear from the site and from Google the moment the CMS answers.
CMS_CONTENT_MODE=merge

# Cache lifetime per serverless instance, milliseconds. Time-based on purpose:
# Vercel instances do not share memory, so a webhook cannot invalidate them all.
CMS_CACHE_TTL_MS=60000

# Request timeout, milliseconds. Below ~5000 a cold Supabase connection will
# drop to the Markdown fallback needlessly.
CMS_TIMEOUT_MS=8000

# URL prefix these posts are served under. Only change this for a deliberate,
# redirect-backed move -- it decides live, indexed URLs.
# CMS_BASE_PATH=/resources
