.DS_Store

# Dependencies
node_modules/

# Environment — NEVER commit real keys
.env
.env.local
.env.*.local
.env.production

# Vercel
.vercel

# Local readable copy of the sitemap (npm run sitemap). Nothing serves it — the
# live /sitemap.xml is built per request — so committing it only invites someone
# to move it back into public/, where it would shadow the live route.
dev-package/sitemap.preview.xml

# One-off comp-account admin scripts — contain a plaintext credential, NEVER commit
dev-package/scripts/create-comp-account.js
dev-package/scripts/remove-comp-account.js
dev-package/scripts/clear-comp-scans.js
docmirror-backup-*.sql
dev-package/scripts/backfill-orgs.js
dev-package/scripts/backfill-orgs.fn.sql
